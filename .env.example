# Kurukoo environment template. NEVER commit real credentials.
# Gemini text is bounded hosted generation; use the cost-conscious 2.5 Flash family by default.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# TTS and Live are separate capabilities and remain unavailable unless explicitly configured.
GEMINI_TTS_MODEL=
GEMINI_LIVE_MODEL=
# Optional Mistral Small hosted generation; it is never selected for every turn.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TRANSCRIPTION_MODEL=voxtral-mini-latest
MISTRAL_TTS_MODEL=
MISTRAL_VISION_MODEL=pixtral-large-latest
KURUKOO_AI_HOSTED_PROVIDER=mistral
MISTRAL_TIMEOUT_MS=15000
KURUKOO_MISTRAL_TRANSCRIPTION_ENABLED=false
HUGGINGFACE_API_KEY=
GROQ_API_KEY=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=
PORT=3000

# Payment & Identity Services
KURUKOO_PAY_PROVIDER=sandbox
MOMO_API_KEY=
PAGA_API_KEY=
STRIPE_SECRET_KEY=
AT_API_KEY=
VERIFYME_SECRET=

# Bounded Autonomous Agent Runtime
KURUKOO_AGENT_ENABLED=true
KURUKOO_AGENT_AUTONOMOUS=true
KURUKOO_AGENT_AUTONOMOUS_LOW_RISK=true
KURUKOO_AGENT_MAX_ACTIONS_PER_CYCLE=8
KURUKOO_AGENT_MAX_RETRIES=2
KURUKOO_AGENT_MAX_CONCURRENT_GOALS=5
KURUKOO_AGENT_COOLDOWN_SECONDS=120
KURUKOO_AGENT_WORKER_INTERVAL_MS=60000
KURUKOO_COORDINATOR_TEACHER_ENABLED=false
KURUKOO_COORDINATOR_PROMOTION_ENABLED=false
KURUKOO_COORDINATOR_POLICY_VERSION=coordinator-policy-v1
CREDIT_ECONOMY_ENABLED=true
DB_PATH=tmp/kurukoo.sqlite

# Security (required in production)
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
OTP_LEGACY_LOGIN=false
OTP_DEBUG=false
KURUKOO_DEV_AUTH=false
KURUKOO_TEST_PHONE=
KURUKOO_TEST_NAME=Kurukoo Development Tester
KURUKOO_EMAIL_OTP_ENABLED=false

# Email channel
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=

# IVR channel
IVR_WEBHOOK_SECRET=
IVR_CALLBACK_URL=

# Progressive trust and channel evidence gates
KURUKOO_PROGRESSIVE_TRUST_ENABLED=false
KURUKOO_PUSH_APPROVAL_ENABLED=false
KURUKOO_CHANNEL_EVIDENCE_ENABLED=false
KURUKOO_LOCATION_CONSENT_ENABLED=false

# Feature Flags
FF_USSD=true
FF_NIMC_KYC=true
FF_MOBILE_MONEY=true
FF_STRIPE_PAYPAL=false
FF_POINTS_ENABLED=true
FF_UK_LIFE_ADMIN=false
FF_AFFILIATE_LINKS=true
FF_CONTRIBUTOR_SYSTEM=true
FF_EMAIL_REQUIRED=false

# Channel Wiring
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DISPLAY_NUMBER=
KURUKOO_WHATSAPP_LINKED_DEVICE_ENABLED=false
KURUKOO_WHATSAPP_LINKED_DEVICE_ALLOW=false
KURUKOO_WHATSAPP_LINKED_DEVICE_AUTOSTART=false
KURUKOO_WHATSAPP_LINKED_DEVICE_OWNER_PHONE=
KURUKOO_WHATSAPP_LINKED_DEVICE_AUTH_DIR=.data/whatsapp-linked-device
KURUKOO_WHATSAPP_LINKED_DEVICE_ALLOW_GROUPS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
APPLE_BC_ENABLED=false
APPLE_BC_SHARED_SECRET=
APPLE_BC_MSP_URL=
APPLE_BC_BID=

# Remote AI app / MCP integration.
# ChatGPT connects to Kurukoo through OAuth and MCP; Kurukoo never receives ChatGPT credentials.
# Keep disabled until the public HTTPS issuer, exact redirect allow-list and client relationship are configured.
KURUKOO_MCP_ENABLED=false
KURUKOO_MCP_ISSUER=
KURUKOO_MCP_CLIENT_ID=
KURUKOO_MCP_CLIENT_SECRET=
KURUKOO_MCP_REDIRECT_URIS=
KURUKOO_MCP_OAUTH_SECRET=
KURUKOO_MCP_ACCESS_TOKEN_TTL_SECONDS=3600
KURUKOO_MCP_REFRESH_TOKEN_TTL_SECONDS=7776000

# Realtime Web Voice
KURUKOO_VOICE_ENABLED=false
KURUKOO_VOICE_PROVIDER=gemini-live
KURUKOO_VOICE_MODEL=gemini-2.5-flash-native-audio-live
KURUKOO_VOICE_EXPERIMENTAL_BROWSER_SPEECH=false
KURUKOO_VOICE_TTS_PROVIDER=disabled
KURUKOO_VOICE_TTS_MODEL=
KURUKOO_VOICE_PROVIDER_BUDGET_PER_DAY=0
KURUKOO_VOICE_MAX_SESSION_SECONDS=900
KURUKOO_VOICE_IDLE_TIMEOUT_SECONDS=120
KURUKOO_VOICE_MAX_CONCURRENT_SESSIONS=2
KURUKOO_VOICE_SESSION_RATE_LIMIT=5

NODE_ENV=development
HOST=0.0.0.0
KURUKOO_SMOLLM2_LOCAL=false
SMOLLM2_MODEL=HuggingFaceTB/SmolLM2-1.7B-Instruct
SMOLLM2_FALLBACK_MODEL=HuggingFaceTB/SmolLM2-1.7B-Instruct
SMOLLM2_DTYPE=q4
SMOLLM2_MAX_NEW_TOKENS=192
GROQ_MAX_CONCURRENT=8
GROQ_MODEL=openai/gpt-oss-20b
AI_QUOTA_COMPLEX_PER_DAY=30
AI_QUOTA_GLOBAL_COMPLEX_PER_MIN=10
AI_QUOTA_HARD_BLOCK=true
AI_QUOTA_SIMPLE_PER_DAY=200
AI_QUOTA_TOKENS_PER_DAY=500000
AI_SIMPLE_CACHE_TTL_MS=300000
CHAT_ATTACHMENT_BODY_LIMIT=10485760
CHAT_UPLOAD_DIR=tmp/uploads
ECONOMIC_PAYMENT_ADAPTER=sandbox
FORCE_SANDBOX_SUBSCRIPTION=true
KURUKOO_DB_SAVE_DEBOUNCE_MS=250
KURUKOO_DEFERRED_INTERVAL_SEC=300
KURUKOO_MEMORY_INTERVAL_SEC=300
KURUKOO_ORCHESTRATION_INTERVAL_SEC=60
KURUKOO_PURGE_INTERVAL_SEC=86400
KURUKOO_REMINDER_INTERVAL_SEC=60
KURUKOO_SAFETY_INTERVAL_SEC=60
KURUKOO_TRUST_SCORE_INTERVAL_SEC=86400
KURUKOO_WORKERS=1
KURUKOO_DISABLE_LISTEN=false
KURUKOO_EXTERNAL_EXECUTION_ENABLED=false
KURUKOO_PROGRAMMATIC_AD_PROVIDER=none
MQTT_BROKER_URL=
HF_API_KEY=
STRIPE_WEBHOOK_SECRET=
FCM_SERVICE_ACCOUNT_JSON=
KURUKOO_FCM_PROJECT_ID=
KURUKOO_FCM_CLIENT_EMAIL=
KURUKOO_FCM_PRIVATE_KEY=
MEMORY_ENCRYPTION_KEY=
QR_CONTEXT_SECRET=
KURUKOO_PRODUCT_CATALOGUE_SECRET=
KURUKOO_NOTIFICATION_MAX_QUEUE=10000

# Personal Telegram linked-device connector
KURUKOO_TELEGRAM_LINKED_DEVICE_ENABLED=false
KURUKOO_TELEGRAM_LINKED_DEVICE_ALLOW=false
KURUKOO_TELEGRAM_LINKED_DEVICE_OWNER_PHONE=
KURUKOO_TELEGRAM_LINKED_DEVICE_AUTH_DIR=.data/telegram-linked-device
KURUKOO_TELEGRAM_LINKED_DEVICE_ALLOW_GROUPS=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_LINKED_DEVICE_2FA_PASSWORD=

FF_PRIVATE_NUMBER_MASKING=false
NUMBER_MASKING_PROVIDER=
KURUKOO_CLOUD_RUN_PROVING=false
KURUKOO_SMOLLM2_STARTUP_MODE=lazy
KURUKOO_SMOLLM2_MAX_CONCURRENCY=1
KURUKOO_SMOLLM2_INIT_TIMEOUT_MS=180000
KURUKOO_SMOLLM2_REQUEST_TIMEOUT_MS=240000
KURUKOO_SMOLLM2_CACHE_DIR=/tmp/huggingface
KURUKOO_SMOLLM2_READINESS_REQUIRED=false
KURUKOO_PERSISTENT_STATE_REQUIRED=true
