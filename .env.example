# Kurukoo environment template. NEVER commit real credentials.
# Hosted AI and external integrations are enabled only when their provider credentials and policy prerequisites are satisfied.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=
GEMINI_LIVE_MODEL=
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TRANSCRIPTION_MODEL=voxtral-mini-latest
MISTRAL_VISION_MODEL=pixtral-large-latest
MISTRAL_TTS_MODEL=
MISTRAL_TTS_VOICE_ID=
MISTRAL_TTS_RESPONSE_FORMAT=mp3
MISTRAL_TIMEOUT_MS=15000
KURUKOO_MISTRAL_TRANSCRIPTION_ENABLED=false
KURUKOO_AI_PRIMARY_PROVIDER=mistral
KURUKOO_AI_BYPASS_SMOLLM2=true
KURUKOO_AI_HOSTED_PROVIDER=mistral
HUGGINGFACE_API_KEY=
HF_API_KEY=
HF_TOKEN=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_TIMEOUT_MS=15000
