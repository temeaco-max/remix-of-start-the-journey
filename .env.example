# SECTION: Feature Flags (§35) — env overrides for locale-driven flags
# Each flag can be forced on/off per environment. Locale files (locales/*.json)
# provide the per-market defaults; these env vars override them.
FF_USSD=true
FF_NIMC_KYC=true
FF_MOBILE_MONEY=true
FF_STRIPE_PAYPAL=false
FF_POINTS_ENABLED=true
FF_UK_LIFE_ADMIN=false
FF_AFFILIATE_LINKS=true
FF_CONTRIBUTOR_SYSTEM=true
FF_EMAIL_REQUIRED=false

# SECTION: Channel Wiring (§6) — webhook credentials
# WhatsApp Cloud API: app secret enables HMAC-SHA256 webhook signature validation.
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DISPLAY_NUMBER=2348000000000
# Telegram Bot: token + webhook secret (X-Telegram-Bot-Api-Secret-Token).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# iMessage / Apple Business Chat (tertiary, UK): requires Apple Business Register + MSP.
