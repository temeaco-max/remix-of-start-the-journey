{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kurukoo.com/schemas/chat/action-proposal.json",
  "title": "Kurukoo bounded AI action proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "relation", "capability", "action", "confidence", "needs_clarification"],
  "properties": {
    "schema_version": {"type": "string"},
    "relation": {"enum": ["answer", "correction", "control", "resume", "create", "switch", "clarify", "continue"]},
    "capability": {"type": ["string", "null"]},
    "action": {"type": ["string", "null"]},
    "context_id": {"type": ["string", "null"]},
    "entities": {"type": "object", "additionalProperties": true},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "needs_clarification": {"type": "boolean"},
    "reason_codes": {"type": "array", "items": {"type": "string"}}
  }
}
