<%- include('_partials/head') %>
<%- include('_partials/nav') %>

<main class="container page-container">
    <section class="page-header-center">
        <div class="badge-pill">
            For You
        </div>
        <h1 class="page-title">
            Who are you on Kurukoo?
        </h1>
        <p class="page-desc">
            One number. Every role. Pick the one that describes you today — you can switch anytime, because it's all the same profile.
        </p>
    </section>

    <div class="role-grid">
        <div class="card role-card">
            <div class="role-icon">🛍️</div>
            <h2 class="role-title">Consumer</h2>
            <p class="role-text"><strong>What you get:</strong> Request any service, matched with trusted providers, escrow protection, Daily Picks tailored to you.</p>
            <p class="role-text-sub"><strong>What you can do:</strong> Order food, book repairs, find rides, get errands done, receive price alerts.</p>
            <a href="https://wa.me/2347000?text=Hi%2C%20I%20need%20help%20with%20something" target="_blank" class="btn btn-primary role-btn-primary">Request a service</a>
        </div>
        <div class="card role-card">
            <div class="role-icon">🧑‍🔧</div>
            <h2 class="role-title">Provider</h2>
            <p class="role-text"><strong>What you get:</strong> List your skills, Work Toggle, Nearby Pulse (Go Live), Boost listings, earn and grow.</p>
            <p class="role-text-sub"><strong>What you can do:</strong> Offer any skill, accept jobs nearby, manage your storefront, reach more customers.</p>
            <a href="https://wa.me/2347000?text=Hi%2C%20I%20want%20to%20offer%20my%20skills" target="_blank" class="btn role-btn-blue">Offer your skills</a>
        </div>
        <div class="card role-card">
            <div class="role-icon">🏪</div>
            <h2 class="role-title">Business</h2>
            <p class="role-text"><strong>What you get:</strong> Verified storefront (chat-managed), catalogue import, analytics, team accounts, advertising.</p>
            <p class="role-text-sub"><strong>What you can do:</strong> Sell locally, reach customers, advertise, reach new buyers via Daily Picks.</p>
            <a href="/pricing" class="btn role-btn-charcoal">Grow my business</a>
        </div>
        <div class="card role-card">
            <div class="role-icon">🤝</div>
            <h2 class="role-title">Physical Agent</h2>
            <p class="role-text"><strong>What you get:</strong> Cash-in/out, onboarding, walk-in assistance, earn commissions.</p>
            <p class="role-text-sub"><strong>What you can do:</strong> Sell Points/top-ups, onboard new users, help people get going.</p>
            <a href="https://wa.me/2347000?text=Hi%2C%20I%20want%20to%20become%20an%20agent" target="_blank" class="btn role-btn-blue">Become an agent</a>
        </div>
        <div class="card role-card">
            <div class="role-icon">🎥</div>
            <h2 class="role-title">Contributor</h2>
            <p class="role-text"><strong>What you get:</strong> Micro-tasks (update prices, confirm locations, incident alerts), earn airtime from the Growth Fund.</p>
            <p class="role-text-sub"><strong>What you can do:</strong> Cover events, get paid for video content, build your badge.</p>
            <a href="https://wa.me/2347000?text=Hi%2C%20I%20want%20to%20be%20a%20contributor" target="_blank" class="btn role-btn-terracotta">Become a contributor</a>
        </div>
        <div class="card role-card">
            <div class="role-icon">🌍</div>
            <h2 class="role-title">Other / Just Looking</h2>
            <p class="role-text"><strong>What you get:</strong> Explore the platform and the 45+ categories, learn more.</p>
            <p class="role-text-sub"><strong>What you can do:</strong> Browse Discover, Explore, check Help & Resources, join a community.</p>
            <a href="/explore" class="btn role-btn-gray">Explore Kurukoo</a>
        </div>
    </div>

    <div class="page-cta-box">
        <p class="page-cta-text">Unsure? Just start chatting — Kurukoo figures out who you are as it learns you.</p>
        <a href="https://wa.me/2347000" target="_blank" class="btn btn-whatsapp">Start on WhatsApp</a>
    </div>
</main>

<%- include('_partials/footer') %>

