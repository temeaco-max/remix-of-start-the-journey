<%- include('../_partials/head', { country, t, seo, schemas, faqs, reqPath }) %>
<%- include('../_partials/nav', { country, t, shortcode }) %>

<main class="explore-container container page-container">
    <section class="page-header-center">
        <span class="badge-pill">Explore Capabilities</span>
        <h1 class="page-title">What can I ask Kurukoo?</h1>
        <p class="page-desc">Kurukoo handles a wide range of requests by matching you with the right capabilities across our network.</p>
        <div class="explore-search-container">
            <input type="text" id="explore-search" class="explore-search-input" placeholder="What do you need? (e.g. plumber, ride, food)..." aria-label="Search Kurukoo capabilities">
            <button type="button" id="explore-search-btn" class="btn btn-primary">Ask Kurukoo</button>
        </div>
    </section>

    <section class="categories-section" aria-labelledby="explore-categories-title">
        <h2 id="explore-categories-title" class="visually-hidden">Kurukoo capabilities</h2>
        <div id="categories-grid" class="categories-grid">
            <% categories.forEach((cat, index) => { %>
                <article class="category-card explore-category-card" data-name="<%= cat.name.toLowerCase() %>">
                    <div class="explore-category-icon" aria-hidden="true"><%= cat.icon %></div>
                    <h3 class="explore-category-title"><%= cat.name %></h3>
                    <p class="explore-category-desc"><%= cat.description %></p>
                    <div class="explore-category-footer"><a href="/chat?prompt=I%20need%20help%20with%20<%= encodeURIComponent(cat.name) %>" class="btn btn-outline btn-sm">Start request</a></div>
                </article>
                <% if ((index + 1) % 8 === 0 && ads && ads.length > 0) { %>
                    <% const adIndex = Math.floor(index / 8) % ads.length; %>
                    <% const ad = ads[adIndex]; %>
                    <article class="sponsored-ad-card" aria-label="Sponsored partner placement">
                        <span class="sponsored-badge">Partner Placement</span>
                        <h4><%= ad.title %></h4>
                        <p><%= ad.desc %></p>
                        <a href="/chat?prompt=Tell%20me%20about%20<%= encodeURIComponent(ad.title) %>" class="text-link">Learn more <span aria-hidden="true">→</span></a>
                    </article>
                <% } %>
            <% }) %>
        </div>
    </section>
</main>

<%- include('../_partials/footer') %>
<script src="/js/kurukoo-app-shell.js" defer></script>