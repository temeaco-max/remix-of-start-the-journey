<div class="linked-device-card" data-linked-device-panel aria-live="polite">
  <div class="linked-device-status-row"><span data-linked-device-status-dot class="linked-device-status-dot"></span><span data-linked-device-status>Ready to start pairing</span></div>
  <div data-linked-device-qr-frame class="linked-device-qr-frame"><div class="linked-device-qr-placeholder">Start pairing to create a secure QR code.</div><img data-linked-device-qr class="linked-device-qr" alt="WhatsApp linked-device pairing QR code" hidden></div>
  <p data-linked-device-error class="linked-device-error" hidden></p>
  <div class="linked-device-actions"><button data-linked-device-start class="linked-device-primary" type="button">Start pairing</button><button data-linked-device-stop class="linked-device-secondary" type="button" hidden>Stop</button><button data-linked-device-logout class="linked-device-secondary" type="button" hidden>Log out device</button></div>
  <p class="linked-device-owner">Signed in as <strong><%= displayName %></strong> · <%= phone %></p>
</div>
<script src="/js/whatsapp-linked-device.js?v=1" defer></script>
