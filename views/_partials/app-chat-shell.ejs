<div class="chat-shell">
  <aside class="chat-sidebar" id="chat-sidebar" aria-label="Kurukoo workspace">
    <div class="sidebar-top">
      <a class="brand" href="/" aria-label="Kurukoo home">
        <img class="brand-mark-image" src="/assets/brand/logo-icon.png" alt="Kurukoo" width="28" height="28">
        <span>Kurukoo</span>
      </a>
      <button class="icon-btn" id="sidebar-collapse" type="button" aria-label="Collapse sidebar" title="Collapse sidebar">
        <svg class="k-icon"><use href="/icons/kurukoo-icons.svg#chevron-left"></use></svg>
      </button>
      <button class="icon-btn chat-mobile-only" id="close-sidebar" type="button" aria-label="Close sidebar" title="Close sidebar">
        <svg class="k-icon"><use href="/icons/kurukoo-icons.svg#close"></use></svg>
      </button>
    </div>
    <button class="new-chat" id="new-chat" type="button">
      <svg class="k-icon"><use href="/icons/kurukoo-icons.svg#plus"></use></svg>
      <span>New conversation</span>
    </button>
    <nav class="workspace-nav" aria-label="Your Kurukoo">
      <a href="/chat" class="workspace-link active conversation-link">
        <svg class="k-icon"><use href="/icons/kurukoo-icons.svg#chat"></use></svg>
        <span>Conversation</span>
      </a>
      <div class="conversation-subnav" aria-label="Conversation workspace">
        <button type="button" class="workspace-link" data-surface-view="requests">
          <svg class="k-icon"><use href="/icons/kurukoo-icons.svg#request"></use></svg>
          <span>Requests</span>
        </button>
        <button type="button" class="workspace-link" data-surface-view="tasks">
          <svg class="k-icon"><use href="/icons/kurukoo-icons.svg#work"></use></svg>
          <span>Tasks</span>
        </button>
        <button type="button" class="workspace-link" data-surface-view="discover">
          <svg class="k-icon"><use href="/icons/kurukoo-icons.svg#discover"></use></svg>
          <span>Discover</span>
        </button>
        <button type="button" class="workspace-link" data-surface-view="connect">
          <svg class="k-icon"><use href="/icons/kurukoo-icons.svg#channels"></use></svg>
          <span>Connect</span>
        </button>
        <button type="button" class="workspace-link" data-surface-view="topics">
          <svg class="k-icon"><use href="/icons/kurukoo-icons.svg#help"></use></svg>
          <span>Topics</span>
        </button>
      </div>
    </nav>
    <button class="sidebar-link sidebar-more-toggle" id="sidebar-more-toggle" type="button" aria-controls="sidebar-more-items" aria-expanded="false">
      <svg class="k-icon"><use href="/icons/kurukoo-icons.svg#more"></use></svg>
      <span>More</span>
    </button>
    <div class="sidebar-sponsored-card" id="sidebar-promo" aria-label="Sponsored local service promotion. Disclosed placement outside your conversation." hidden>
      <img src="" alt="" loading="lazy">
      <span class="sidebar-sponsored-tag">Sponsored</span>
    </div>
    <div class="history-heading">Recent conversations</div>
    <div class="history-list" id="history-list"></div>
    <div class="sidebar-status-card">
      <div class="status-card-title">Your presence</div>
      <div class="status-card-row">
        <span class="status-dot"></span>
        <span>Presence</span>
        <strong id="sidebar-presence" data-agent-presence="idle" data-agent-presence-label>Available</strong>
      </div>
      <div class="status-card-row">
        <span class="status-dot is-muted"></span>
        <span>Memory</span>
        <strong id="sidebar-memory-status">In use</strong>
      </div>
      <div class="status-card-row">
        <span class="status-dot"></span>
        <span>Connected</span>
        <strong id="sidebar-channel-status">Web</strong>
      </div>
      <div class="presence-radar-control">
        <button type="button" id="radar-toggle" class="radar-toggle is-active" aria-pressed="true" aria-label="Nearby Radar ready">
          <span class="radar-toggle-icon"><span class="radar-wave"></span></span>
          <span><strong>Nearby radar</strong><small id="radar-status">Ready</small></span>
          <svg class="k-icon"><use href="/icons/kurukoo-icons.svg#chevron-right"></use></svg>
        </button>
      </div>
    </div>
    <div class="sidebar-context">
      <div class="context-title">Your Kurukoo</div>
      <div class="context-copy" id="memory-context">Your conversations, reminders and saved context stay connected to your profile.</div>
    </div>
    <div class="sidebar-bottom" id="sidebar-more-items" hidden>
      <div class="sidebar-utility-grid">
        <button class="sidebar-link" type="button" data-surface-view="reminders">
          <svg class="k-icon"><use href="/icons/kurukoo-icons.svg#notification"></use></svg>
          <span>Reminders</span>
        </button>
        <button class="sidebar-link" type="button" data-surface-view="saved">
          <svg class="k-icon"><use href="/icons/kurukoo-icons.svg#saved"></use></svg>
          <span>Saved</span>
        </button>
        <button class="sidebar-link" type="button" data-surface-view="wallet">
          <svg class="k-icon"><use href="/icons/kurukoo-icons.svg#wallet"></use></svg>
          <span>Wallet</span>
        </button>
        <button class="sidebar-link" type="button" data-surface-view="settings">
          <svg class="k-icon"><use href="/icons/kurukoo-icons.svg#settings"></use></svg>
          <span>Settings</span>
        </button>
      </div>
      <a class="sidebar-link" href="/help">
        <svg class="k-icon"><use href="/icons/kurukoo-icons.svg#help"></use></svg>
        <span>Help</span>
      </a>
    </div>
  </aside>
  <main class="chat-main">
    <header class="chat-header">
      <button class="icon-btn chat-mobile-only" id="open-sidebar" type="button" aria-label="Open sidebar" title="Open sidebar">
        <svg class="k-icon"><use href="/icons/kurukoo-icons.svg#menu"></use></svg>
      </button>
      <div class="chat-header-title">
        <span class="chat-header-label">Conversation</span>
        <span class="chat-header-meta" id="chat-status">Kurukoo is ready</span>
      </div>
      <div class="chat-header-actions">
        <button class="icon-btn" id="toggle-inspector" type="button" aria-label="Toggle context panel" title="Toggle context panel">
          <svg class="k-icon"><use href="/icons/kurukoo-icons.svg#panel-right"></use></svg>
        </button>
        <button class="icon-btn" id="theme-toggle" type="button" aria-label="Toggle theme" title="Toggle theme">
          <svg class="k-icon"><use href="/icons/kurukoo-icons.svg#theme"></use></svg>
        </button>
      </div>
    </header>
    <div class="welcome" id="welcome">
      <div class="welcome-mark">
        <img src="/assets/brand/logo-icon.png" alt="Kurukoo" width="40" height="40">
      </div>
      <h1 class="welcome-title">Tell Kurukoo what you need</h1>
      <p class="welcome-subtitle">Kurukoo helps with everyday life and work &mdash; sourcing, coordination, reminders, discovery and more.</p>
      <div class="welcome-quick-actions">
        <button type="button" data-prompt="Set a reminder">
          <svg class="k-icon"><use href="/icons/kurukoo-icons.svg#reminder"></use></svg>
          <span>Set a reminder</span>
        </button>
        <button type="button" data-prompt="I need something sourced">
          <svg class="k-icon"><use href="/icons/kurukoo-icons.svg#package"></use></svg>
          <span>Source something</span>
        </button>
        <button type="button" data-prompt="I need to get somewhere">
          <svg class="k-icon"><use href="/icons/kurukoo-icons.svg#ride"></use></svg>
          <span>Get somewhere</span>
        </button>
        <button type="button" data-prompt="Help me earn money">
          <svg class="k-icon"><use href="/icons/kurukoo-icons.svg#work"></use></svg>
          <span>Earn</span>
        </button>
      </div>
    </div>
    <div class="chat-scroll" id="chat-scroll">
      <div class="chat-content" id="chat-content"></div>
      <div class="chat-scroll-anchor" id="chat-scroll-anchor"></div>
    </div>
    <div class="chat-composer">
      <div class="composer-status" id="composer-status" role="status" aria-live="polite" hidden></div>
      <div class="qr-context-banner" id="qr-context-banner" role="status" aria-live="polite" hidden></div>
      <div class="voice-status" id="voice-status" role="status" aria-live="polite" hidden></div>
      <button class="voice-end" id="voice-end" type="button" hidden>End voice</button>
      <div class="deferred-status" id="deferred-status" hidden></div>
      <div class="native-assistance-status" id="native-assistance-status" role="status" hidden></div>
      <div class="composer-quick-actions" id="composer-quick-actions">
        <button type="button" data-prompt="Set a reminder">
          <svg class="k-icon"><use href="/icons/kurukoo-icons.svg#reminder"></use></svg>
          Reminder
        </button>
        <button type="button" data-prompt="Manage my safety contacts and check-ins">
          <svg class="k-icon"><use href="/icons/kurukoo-icons.svg#safety"></use></svg>
          Safety
        </button>
        <button type="button" data-prompt="I need something sourced">
          <svg class="k-icon"><use href="/icons/kurukoo-icons.svg#package"></use></svg>
          Source something
        </button>
        <button type="button" data-prompt="I need to get somewhere">
          <svg class="k-icon"><use href="/icons/kurukoo-icons.svg#ride"></use></svg>
          Get somewhere
        </button>
        <button type="button" data-prompt="Help me earn money">
          <svg class="k-icon"><use href="/icons/kurukoo-icons.svg#work"></use></svg>
          Earn
        </button>
      </div>
      <div class="attachment-preview" id="attachment-preview" hidden></div>
      <div class="composer">
        <input type="file" id="file-input" hidden accept="image/png,image/jpeg,image/webp,image/gif,application/pdf,video/mp4,video/webm">
        <button class="composer-btn" id="attach-file" type="button" aria-label="Attach file">
          <svg class="k-icon"><use href="/icons/kurukoo-icons.svg#attach"></use></svg>
        </button>
        <textarea id="message-input" rows="1" maxlength="12000" placeholder="Tell Kurukoo what you need&#8230;" aria-label="Message Kurukoo"></textarea>
        <button class="composer-btn" id="voice-input" type="button" aria-label="Use voice input">
          <svg class="k-icon"><use href="/icons/kurukoo-icons.svg#mic"></use></svg>
        </button>
        <button class="composer-btn primary" id="send-message" type="button" aria-label="Send message">
          <svg class="k-icon"><use href="/icons/kurukoo-icons.svg#send"></use></svg>
        </button>
      </div>
      <div class="composer-disclaimer">Kurukoo can help with a wide range of tasks. Responses may be verified by Kurukoo before acting.</div>
    </div>
  </main>
  <aside class="chat-inspector" id="chat-inspector" aria-label="Conversation context">
    <div class="inspector-header">
      <span class="inspector-context-label" id="inspector-title">Context</span>
      <button class="icon-btn inspector-collapse-button" id="inspector-collapse" type="button" aria-label="Collapse context panel" title="Collapse context panel">
        <svg class="k-icon" aria-hidden="true"><use href="/icons/kurukoo-icons.svg#chevron-left"></use></svg>
      </button>
      <button class="icon-btn inspector-close-button" id="close-inspector" type="button" aria-label="Close context panel" title="Close context panel">&times;</button>
    </div>
    <div class="inspector-card context-intro" data-context-card="all requests saved">
      <div class="inspector-label">Current request</div>
      <p>Request details and next actions appear here as Kurukoo works.</p>
    </div>
    <div class="inspector-discovery-stack" id="discovery-context-card" data-context-card="discover daily-picks requests cart">
      <button class="inspector-image-card inspector-image-card-button" id="daily-picks-promo-card" type="button" data-surface-view="daily-picks" aria-label="Daily Picks. Open the streamlined discovery view." hidden>
        <img id="daily-picks-promo-image" src="" alt="" loading="lazy">
        <span class="inspector-card-tag">Daily Picks</span>
        <span class="inspector-card-arrow" aria-hidden="true">
          <svg class="k-icon"><use href="/icons/kurukoo-icons.svg#chevron-right"></use></svg>
        </span>
      </button>
    </div>
    <div class="inspector-card" id="connect-context-card" data-context-card="connect">
      <div class="inspector-label">Channel setup</div>
      <div class="channel-context-list">
        <div><strong>Web Chat</strong><small>Ready now</small></div>
        <div><strong>WhatsApp</strong><small>Setup required</small></div>
        <div><strong>Telegram</strong><small>Setup required</small></div>
      </div>
      <button class="inspector-menu-link" type="button" data-surface-view="connect">
        <span class="inspector-link-copy"><strong>Manage channels</strong><small>Connect an access point</small></span>
        <svg class="k-icon inspector-link-chevron"><use href="/icons/kurukoo-icons.svg#chevron-right"></use></svg>
      </button>
    </div>
    <div class="inspector-card" id="cart-context-card" data-context-card="cart requests">
      <div class="inspector-label">Cart</div>
      <div class="empty-state" id="inspector-cart">No items in cart.</div>
      <button class="inspector-menu-link" type="button" data-surface-view="cart">
        <span class="inspector-link-icon">
          <svg class="k-icon"><use href="/icons/kurukoo-icons.svg#cart"></use></svg>
        </span>
        <span class="inspector-link-copy">
          <strong>Open Cart</strong>
          <small>Review before requesting</small>
        </span>
        <svg class="k-icon inspector-link-chevron"><use href="/icons/kurukoo-icons.svg#chevron-right"></use></svg>
      </button>
    </div>
    <div class="inspector-card" id="daily-picks-card" data-context-card="discover daily-picks" hidden>
      <div class="inspector-label">Daily Picks</div>
      <div class="inspector-note">Curated local picks appear here when available.</div>
    </div>
    <div class="inspector-card agent-goal-card" id="agent-goal-card" data-context-card="agent requests tasks" hidden>
      <div class="inspector-label" id="agent-goal-label">Agent goal</div>
      <div class="agent-goal-status">
        <span class="agent-goal-indicator"></span>
        <span id="agent-goal-state">Idle</span>
      </div>
      <div class="agent-goal-progress">
        <div class="agent-goal-progress-bar" id="agent-goal-progress-bar"></div>
      </div>
      <p class="agent-goal-detail" id="agent-goal-detail">
        Kurukoo continues working on your request in the background. Continue in Chat when you are ready.
      </p>
    </div>
    <div class="inspector-list" id="agent-goal-events"></div>
    <div class="agent-goal-actions">
      <button class="text-btn" id="agent-goal-pause" type="button" hidden>Pause</button>
      <button class="text-btn" id="agent-goal-cancel" type="button" hidden>Stop follow-up</button>
    </div>
    <div class="inspector-card" id="nearby-context-card" data-context-card="discover requests cart daily-picks">
      <div class="inspector-label" id="nearby-context-label">Nearby</div>
      <div class="radar-list" id="radar-list">
        <div class="empty-state">Ask Kurukoo what is nearby when local discovery is useful.</div>
      </div>
    </div>
    <div class="inspector-card task-context-card" id="task-context-card" data-context-card="tasks requests">
      <div class="inspector-label">Tasks</div>
      <div class="task-context-list" id="task-context-list">
        <div class="empty-state">Checking for pending tasks&#8230;</div>
      </div>
      <button class="inspector-menu-link task-context-link" type="button" data-surface-view="tasks">
        <span class="inspector-link-icon">
          <svg class="k-icon"><use href="/icons/kurukoo-icons.svg#work"></use></svg>
        </span>
        <span class="inspector-link-copy">
          <strong>Open Tasks</strong>
          <small>See the full task workspace</small>
        </span>
        <svg class="k-icon inspector-link-chevron"><use href="/icons/kurukoo-icons.svg#chevron-right"></use></svg>
      </button>
    </div>
    <div class="inspector-card" id="memory-context-card" data-context-card="memory settings safety">
      <div class="inspector-label">Memory</div>
      <div class="empty-state" id="inspector-memory">Shared from your Memory Profile when you are signed in.</div>
    </div>
    <div class="inspector-card" id="reminders-card" data-context-card="reminders requests tasks" hidden>
      <div class="inspector-label">Reminders</div>
      <div class="empty-state" id="reminder-list">No active reminders.</div>
    </div>
    <div class="inspector-card" id="safety-card" data-context-card="safety requests" hidden>
      <div class="inspector-label">Personal safety</div>
      <p class="inspector-note">Kurukoo can coordinate safety instructions, but it is not an emergency responder. Contact notifications require a configured delivery service.</p>
      <form id="safety-contact-form" class="inspector-form">
        <input id="safety-contact-name" required placeholder="Contact name">
        <input id="safety-contact-phone" required placeholder="Phone number">
        <input id="safety-contact-relationship" placeholder="Relationship (optional)">
        <button class="primary-btn" type="submit">Add contact</button>
      </form>
      <div id="inspector-feedback" class="inspector-feedback" role="status" hidden></div>
      <div id="safety-contact-list" class="inspector-list"></div>
      <div id="safety-checkin-list" class="inspector-list"></div>
    </div>
  </aside>
</div>
<script src="https://cdn.jsdelivr.net/npm/marked@15.0.7/marked.min.js" async></script>
<script src="https://cdn.jsdelivr.net/npm/@highlightjs/cdn-assets@11.11.1/highlight.min.js" async></script>
<script src="/js/kurukoo-workspace.js?v=6" defer></script>
<script src="/js/kurukoo-speech-output.js?v=1" defer></script>
<script src="/js/kurukoo-agent-presence.js?v=1" defer></script>
<script src="/js/kurukoo-turn-state.js?v=1" defer></script>
<script src="/js/kurukoo-primary-chat.js?v=22" defer></script>
<script type="module" src="/js/kurukoo-voice.js?v=1"></script>
<script src="/js/kurukoo-qr.js?v=1" defer></script>
<script src="/js/kurukoo-pwa.js?v=6" defer></script>
<script type="application/json" id="chat-init-data">{"conversationId":"","shareId":""}</script>
