<%- include('_partials/head') %>
<%- include('_partials/nav') %>

<main class="py-16 bg-slate-50 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold tracking-wider uppercase bg-emerald-100 text-emerald-800 mb-4">Kurukoo Desktop & Mobile Apps</span>
            <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">
                Download Kurukoo for Your Device
            </h1>
            <p class="text-lg text-slate-600 leading-relaxed">
                Just like WhatsApp, access Kurukoo instantly on your browser at <a href="/web" class="text-emerald-600 font-semibold hover:underline">web.kurukoo.com</a>, or install our dedicated desktop and mobile applications for macOS, Windows, Android, and iOS.
            </p>
        </div>

        <!-- Web App Quick Launch Banner -->
        <div class="bg-gradient-to-r from-emerald-600 to-teal-700 rounded-2xl shadow-xl p-8 mb-16 text-white flex flex-col md:flex-row items-center justify-between">
            <div class="mb-6 md:mb-0 md:mr-8">
                <h2 class="text-2xl font-bold mb-2">Kurukoo Web App (web.kurukoo.com)</h2>
                <p class="text-emerald-100 text-sm sm:text-base">
                    Open Kurukoo instantly in your web browser. Send messages, manage your wallet, view nearby radar, and chat with AI agents without downloading anything.
                </p>
            </div>
            <a href="/web" class="bg-white text-emerald-800 hover:bg-emerald-50 px-8 py-3.5 rounded-xl font-bold shadow-lg transition transform hover:-translate-y-0.5 whitespace-nowrap">
                Open web.kurukoo.com
            </a>
        </div>

        <!-- Desktop & Mobile Platform Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            
            <!-- macOS -->
            <div class="bg-white rounded-2xl shadow-md border border-slate-200 p-8 flex flex-col justify-between transition hover:shadow-lg">
                <div>
                    <div class="w-14 h-14 bg-slate-900 text-white rounded-xl flex items-center justify-center font-bold text-2xl mb-6 shadow">
                        
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">macOS App</h3>
                    <p class="text-sm text-slate-500 mb-6">
                        Compatible with macOS 11.0 or later (Apple Silicon & Intel). Native PWA desktop wrapper with system tray notifications.
                    </p>
                    <ul class="text-xs text-slate-600 space-y-2 mb-6">
                        <li>✓ Native Mac notifications</li>
                        <li>✓ Keyboard shortcuts</li>
                        <li>✓ Background auto-sync</li>
                    </ul>
                </div>
                <a href="/web" class="w-full bg-slate-900 hover:bg-slate-800 text-white text-center py-3 rounded-xl font-semibold text-sm transition">
                    Download for Mac
                </a>
            </div>

            <!-- Windows -->
            <div class="bg-white rounded-2xl shadow-md border border-slate-200 p-8 flex flex-col justify-between transition hover:shadow-lg">
                <div>
                    <div class="w-14 h-14 bg-blue-600 text-white rounded-xl flex items-center justify-center font-bold text-xl mb-6 shadow">
                        ⊞
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">Windows App</h3>
                    <p class="text-sm text-slate-500 mb-6">
                        Compatible with Windows 10 and 11 (64-bit). Fast, lightweight installer with desktop shortcut integration.
                    </p>
                    <ul class="text-xs text-slate-600 space-y-2 mb-6">
                        <li>✓ Windows taskbar integration</li>
                        <li>✓ Offline caching support</li>
                        <li>✓ Instant updates</li>
                    </ul>
                </div>
                <a href="/web" class="w-full bg-blue-600 hover:bg-blue-700 text-white text-center py-3 rounded-xl font-semibold text-sm transition">
                    Download for Windows
                </a>
            </div>

            <!-- Android -->
            <div class="bg-white rounded-2xl shadow-md border border-slate-200 p-8 flex flex-col justify-between transition hover:shadow-lg">
                <div>
                    <div class="w-14 h-14 bg-emerald-600 text-white rounded-xl flex items-center justify-center font-bold text-xl mb-6 shadow">
                        🤖
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">Android App</h3>
                    <p class="text-sm text-slate-500 mb-6">
                        Available on Google Play Store or direct APK download. Works with USSD *7000# and WhatsApp bridge.
                    </p>
                    <ul class="text-xs text-slate-600 space-y-2 mb-6">
                        <li>✓ Push notifications</li>
                        <li>✓ Contact sync support</li>
                        <li>✓ Low data usage mode</li>
                    </ul>
                </div>
                <a href="https://play.google.com" target="_blank" rel="noopener" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white text-center py-3 rounded-xl font-semibold text-sm transition">
                    Get it on Google Play
                </a>
            </div>

            <!-- iOS -->
            <div class="bg-white rounded-2xl shadow-md border border-slate-200 p-8 flex flex-col justify-between transition hover:shadow-lg">
                <div>
                    <div class="w-14 h-14 bg-slate-800 text-white rounded-xl flex items-center justify-center font-bold text-xl mb-6 shadow">
                        📱
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">iOS App</h3>
                    <p class="text-sm text-slate-500 mb-6">
                        Download from the Apple App Store for iPhone and iPad. Seamless integration with iOS share sheet.
                    </p>
                    <ul class="text-xs text-slate-600 space-y-2 mb-6">
                        <li>✓ iOS widget support</li>
                        <li>✓ Secure biometric login</li>
                        <li>✓ Siri shortcut ready</li>
                    </ul>
                </div>
                <a href="https://apple.com/app-store" target="_blank" rel="noopener" class="w-full bg-slate-800 hover:bg-slate-900 text-white text-center py-3 rounded-xl font-semibold text-sm transition">
                    Download on App Store
                </a>
            </div>

        </div>

        <!-- Additional Info -->
        <div class="mt-16 bg-white rounded-2xl border border-slate-200 p-8 text-center max-w-3xl mx-auto">
            <h3 class="text-lg font-bold text-slate-900 mb-2">Need help getting connected?</h3>
            <p class="text-sm text-slate-600 mb-6">
                Kurukoo connects directly through WhatsApp at <span class="font-semibold text-emerald-600">+234 7000</span> or via USSD at <span class="font-semibold text-emerald-600">*7000#</span>. No separate registration required.
            </p>
            <div class="flex justify-center space-x-4">
                <a href="/help" class="text-sm text-emerald-600 font-semibold hover:underline">Visit Help Center</a>
                <span class="text-slate-300">•</span>
                <a href="https://wa.me/2347000" class="text-sm text-emerald-600 font-semibold hover:underline">Message on WhatsApp</a>
            </div>
        </div>
    </div>
</main>

<%- include('_partials/footer') %>
