<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= workspaceTitle %> · Kurukoo</title>
  <meta name="description" content="<%= workspaceDescription %>">
  <link rel="icon" href="/assets/brand/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/site.css?v=1.2.1">
  <link rel="stylesheet" href="/css/kurukoo-workspace.css?v=5">
  <link rel="stylesheet" href="/css/kurukoo-chat.css?v=14">
</head>
<body class="workspace-page" data-workspace-section="<%= workspaceSection %>">
  <% const icon = (name) => `<svg class="k-icon" aria-hidden="true"><use href="/icons/kurukoo-icons.svg#${name}"></use></svg>`; %>
  <div class="workspace-shell chat-template-shell">
    <aside class="workspace-sidebar" id="workspace-sidebar">
      <div class="workspace-brand-row"><a href="/chat" class="workspace-brand"><img src="/assets/brand/logo-icon.svg" alt="Kurukoo" width="34" height="34"><span>Kurukoo</span></a><button id="workspace-collapse" class="workspace-icon-button" type="button" aria-label="Collapse sidebar">‹</button></div>
      <a href="/chat" class="workspace-new"><span aria-hidden="true">＋</span> New conversation</a>
      <nav class="workspace-nav" aria-label="Workspace">
        <a href="/chat"><span class="workspace-nav-icon"><%- icon('chat') %></span><span>Conversation</span></a>
        <a class="<%= workspaceSection === 'requests' ? 'active' : '' %>" href="/requests"><span class="workspace-nav-icon"><%- icon('request') %></span><span>Requests</span></a>
        <a class="<%= workspaceSection === 'reminders' ? 'active' : '' %>" href="/reminders"><span class="workspace-nav-icon"><%- icon('reminder') %></span><span>Reminders</span></a>
        <a class="<%= workspaceSection === 'saved' ? 'active' : '' %>" href="/saved"><span class="workspace-nav-icon"><%- icon('saved') %></span><span>Saved &amp; offers</span></a>
        <a class="<%= workspaceSection === 'cart' ? 'active' : '' %>" href="/cart"><span class="workspace-nav-icon"><%- icon('package') %></span><span>Cart</span></a>
        <button class="workspace-nav-more" id="workspace-more" type="button" aria-expanded="false" aria-controls="workspace-more-items"><span class="workspace-nav-icon"><%- icon('more') %></span><span>More</span></button>
        <div class="workspace-nav-more-items" id="workspace-more-items" hidden>
          <a class="<%= workspaceSection === 'points' ? 'active' : '' %>" href="/points"><span class="workspace-nav-icon"><%- icon('points') %></span><span>Points</span></a><a class="<%= workspaceSection === 'topup' ? 'active' : '' %>" href="/top-up"><span class="workspace-nav-icon"><%- icon('points') %></span><span>Top up</span></a><a class="<%= workspaceSection === 'subscription' ? 'active' : '' %>" href="/subscription"><span class="workspace-nav-icon"><%- icon('settings') %></span><span>Subscription</span></a>
          <a class="<%= workspaceSection === 'tasks' ? 'active' : '' %>" href="/tasks"><span class="workspace-nav-icon"><%- icon('work') %></span><span>Tasks</span></a><a class="<%= workspaceSection === 'connect' ? 'active' : '' %>" href="/connect"><span class="workspace-nav-icon"><%- icon('settings') %></span><span>Connect</span></a>
          <a class="<%= workspaceSection === 'daily-picks' ? 'active' : '' %>" href="/daily-picks"><span class="workspace-nav-icon"><%- icon('discover') %></span><span>Daily Picks</span></a><a href="/discover"><span class="workspace-nav-icon"><%- icon('discover') %></span><span>Discover</span></a>
        </div>
      </nav>
      <div class="workspace-sidebar-spacer"></div>
      <nav class="workspace-nav workspace-nav-secondary" aria-label="Account">
        <a class="<%= workspaceSection === 'memory' ? 'active' : '' %>" href="/memory"><span class="workspace-nav-icon"><%- icon('saved') %></span><span>Memory</span></a><a class="<%= workspaceSection === 'safety' ? 'active' : '' %>" href="/safety"><span class="workspace-nav-icon"><%- icon('safety') %></span><span>Safety</span></a><a class="<%= workspaceSection === 'call' ? 'active' : '' %>" href="/call"><span class="workspace-nav-icon"><%- icon('mic') %></span><span>Call</span></a><a class="<%= workspaceSection === 'settings' ? 'active' : '' %>" href="/settings"><span class="workspace-nav-icon"><%- icon('settings') %></span><span>Settings</span></a><a href="/help"><span class="workspace-nav-icon"><%- icon('help') %></span><span>Help</span></a><button type="button" id="workspace-logout" class="workspace-nav-button"><span class="workspace-nav-icon"><%- icon('logout') %></span><span>Sign out</span></button>
      </nav>
      <div class="workspace-account"><div class="workspace-avatar"><%= (displayName || 'K').slice(0,1).toUpperCase() %></div><div><strong><%= displayName || 'Your Kurukoo account' %></strong><small><%= phone || 'Signed in' %></small></div></div>
    </aside>
    <main class="workspace-main">
      <header class="workspace-header"><div class="workspace-header-copy"><a class="workspace-back" href="/chat"><%- icon('chevron-left') %><span>Back to conversation</span></a><span class="workspace-kicker">Your Kurukoo</span><h1><%= workspaceTitle %></h1><p><%= workspaceDescription %></p></div><div class="workspace-header-actions"><a class="workspace-button secondary ask-cta" href="/chat"><span class="ask-mark"><img src="/assets/brand/logo-icon.svg" alt="" aria-hidden="true"></span><span>Ask</span></a><button class="workspace-icon-button workspace-mobile-only" id="workspace-open" type="button" aria-label="Open workspace navigation">☰</button></div></header>
      <div class="workspace-content">
        <% if (workspaceSection === 'requests') { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">Request timeline</span><h2>Keep every request in one place.</h2><p>Conversation stays the source of truth. This workspace mirrors each canonical request state without creating a second lifecycle.</p></div><a class="workspace-button" href="/chat">Start a new request</a></section>
          <div class="workspace-grid three"><article class="metric-card"><span>Open requests</span><strong data-request-metric="open">—</strong><small>Requests that are still being coordinated.</small></article><article class="metric-card"><span>Waiting on you</span><strong data-request-metric="action">—</strong><small>Confirmations, details or decisions needed to continue.</small></article><article class="metric-card"><span>Completed</span><strong data-request-metric="completed">—</strong><small>Finished requests remain connected to their conversations.</small></article></div>
          <section class="workspace-panel"><div class="panel-heading"><div><span class="workspace-eyebrow">Fulfilment timeline</span><h2>Your requests</h2></div><span class="status-pill">Live request data</span></div><div class="workspace-data-list" data-requests-list aria-live="polite"></div><div class="empty-workspace" data-requests-empty><div class="empty-icon"><%- icon('request') %></div><h3>No requests yet</h3><p>Tell Kurukoo what you need. A request appears here when it is created through conversation.</p><a class="workspace-text-action ask-cta" href="/chat"><span class="ask-mark"><img src="/assets/brand/logo-icon.svg" alt="" aria-hidden="true"></span><span>Ask</span></a></div></section>
        <% } else if (workspaceSection === 'reminders') { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">Remember the things that matter</span><h2>Reminders that live with your conversations.</h2><p>Create one here or simply tell Kurukoo, “Remind me to renew my MOT in September.”</p></div><a class="workspace-button" href="/chat?prompt=Create%20a%20reminder">Create reminder</a></section><div class="workspace-tabs" aria-label="Reminder views"><button class="active" type="button">Upcoming</button><button type="button" disabled>Today</button><button type="button" disabled>Completed</button><button type="button" disabled>Snoozed</button></div><section class="workspace-panel"><div class="workspace-data-list" data-reminders-list aria-live="polite"></div><div class="empty-workspace" data-reminders-empty><div class="empty-icon"><%- icon('reminder') %></div><h3>No upcoming reminders</h3><p>Your reminder service is connected to this workspace. New reminders will appear here with their schedule and next action.</p><a href="/chat?prompt=Create%20a%20reminder">Ask Kurukoo to remind me</a></div></section>
        <% } else if (workspaceSection === 'connect') { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">One Kurukoo relationship</span><h2>Connect the channels and AI assistants you already use.</h2><p>Every connection enters the same Kurukoo relationship. Web Chat remains the source of truth, while external AI assistants can reach the same capabilities through the shared MCP boundary.</p></div><a class="workspace-button" href="/channels#ai-assistants">AI connections</a></section>
          <div class="workspace-grid two linked-device-workspace-grid"><section class="workspace-panel"><div class="panel-heading"><div><span class="workspace-eyebrow">AI assistants</span><h2>One MCP connection</h2></div><span class="status-pill"><%= process.env.KURUKOO_MCP_ENABLED === 'true' ? 'READY' : 'NOT CONFIGURED' %></span></div><p>ChatGPT, Claude, Gemini, Grok, Copilot, Dola and other compatible clients can use the same Kurukoo MCP endpoint when their own product supports custom MCP/OAuth connections. Kurukoo does not collect another AI provider's password or subscription credentials.</p><a class="workspace-text-action" href="/channels#ai-assistants">View AI connection</a></section><section class="workspace-panel"><div class="panel-heading"><div><span class="workspace-eyebrow">Personal WhatsApp</span><h2>Linked device</h2></div><span class="status-pill">Owner-scoped</span></div><p class="channel-readiness-note">Provider readiness: <strong><%= channelStatuses?.whatsapp?.state || 'NOT_CONFIGURED' %></strong>.</p><p>Pair an existing WhatsApp account by scanning a live QR code. This remains separate from a Meta Cloud API business number.</p><a class="workspace-text-action" href="/whatsapp-linked-device">Open pairing view</a></section><section class="workspace-panel"><div class="panel-heading"><div><span class="workspace-eyebrow">Personal Telegram</span><h2>Linked device</h2></div><span class="status-pill">MTProto session</span></div><p class="channel-readiness-note">Provider readiness: <strong><%= channelStatuses?.telegram?.state || 'NOT_CONFIGURED' %></strong>.</p><p>Pair a personal Telegram account with a real Telegram QR login. This remains separate from the Telegram Bot API.</p><%- include('_partials/telegram-linked-device-panel') %></section></div>
        <% } else { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">Your Kurukoo</span><h2>Keep your useful context together.</h2><p>Manage the account, memory, connected channels and other workspace surfaces without creating parallel request or conversation systems.</p></div><a class="workspace-button ask-cta" href="/chat"><span class="ask-mark"><img src="/assets/brand/logo-icon.svg" alt="" aria-hidden="true"></span><span>Ask</span></a></section>
        <% } %>
        <% if (typeof ads === 'undefined' || !Array.isArray(ads) || !ads.length) { %><section class="workspace-promo"><div><span>Sponsored</span><strong>Local service promotion</strong><p>Advertisement placement preview. Sponsored content will never interrupt an active conversation.</p></div><em>No active promotion</em></section><% } %>
        <section class="workspace-proactive" data-proactive-card><span class="workspace-eyebrow">A quick question</span><h2>Was your recent request resolved?</h2><p>Proactive prompts are dismissible and only appear when relevant.</p><div><button type="button" data-proactive-response="yes">Yes</button><button type="button" data-proactive-response="not-yet">Not yet</button><button class="quiet" type="button" data-proactive-dismiss>Dismiss</button></div></section>
      </div>
    </main>
  </div>
  <script src="/js/kurukoo-workspace.js?v=5" defer></script>
</body>
</html>