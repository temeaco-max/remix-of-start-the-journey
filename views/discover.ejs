<%- include('_partials/head') %>
<%- include('_partials/nav') %>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<main class="container discover-main">
    <section class="advertise-hero">
        <div class="category-badge-pill">Discover</div>
        <h1 class="advertise-title">Find useful things around you.</h1>
        <p class="advertise-desc">Explore services, opportunities, events and other useful activity when reliable location context and recorded evidence are available. Locations are fuzzed for privacy.</p>
    </section>

    <section class="discover-intro-cards" aria-label="Discover pathways"><article class="network-card discover-intro-card"><span aria-hidden="true">⌖</span><h2>Nearby services</h2><p>Explore eligible local capabilities when reliable location and availability data exists.</p></article><article class="network-card discover-intro-card"><span aria-hidden="true">◇</span><h2>Events &amp; opportunities</h2><p>Discover useful activity without turning the network into a conventional directory.</p></article><article class="network-card discover-intro-card"><span aria-hidden="true">△</span><h2>Safety &amp; urgent help</h2><p>Get guidance and coordination support while keeping emergency-service boundaries clear.</p></article></section>

    <div id="layer-chips" class="layer-chips-bar" aria-label="Discovery layers">
        <button type="button" class="layer-chip active" data-layer="provider" aria-pressed="true">Providers</button>
        <button type="button" class="layer-chip" data-layer="service" aria-pressed="true">Services</button>
        <button type="button" class="layer-chip" data-layer="place" aria-pressed="true">Places</button>
        <button type="button" class="layer-chip" data-layer="event" aria-pressed="true">Events</button>
        <button type="button" class="layer-chip" data-layer="agent" aria-pressed="true">Agents</button>
        <button type="button" class="layer-chip" data-layer="community_context" aria-pressed="true">Community context</button>
    </div>

    <div class="discover-layout">
        <div id="discover-map" class="discover-map-box" aria-label="Discovery network map"></div>
        <aside class="discover-network-list" aria-label="Nearby discovery results">
            <h2>Discovery network</h2>
            <p class="discover-disclaimer">These are source-attributed discovery items. A business or place is not a Kurukoo provider unless it is claimed, verified and currently available.</p>
            <div id="discover-list" class="k-list"><div class="k-row"><span>Locating useful discovery context…</span><span class="k-muted">Permission required</span></div></div>
        </aside>
    </div>

    <p class="discover-disclaimer">Privacy: your location is coarse for discovery and map coordinates are fuzzed. Exact provider coordinates are never returned to the browser.</p>
</main>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin="" defer></script>
<script src="/js/kurukoo-discover-map.js" defer></script>

<%- include('_partials/footer') %>
