<script src="/js/kurukoo-chat.js"></script>
<script>
    window.addEventListener('DOMContentLoaded', () => {
        if (window.KurukooChat && typeof window.KurukooChat.init === 'function') {
            window.KurukooChat.init({
                containerId: 'homepage-live-chat-embed',
                mode: 'homepage_simulation',
                mockScript: [
                    { sender: 'assistant', content: 'Ku Kurukoo! 🌅 Found active services and helpers near you in Lagos right now.' },
                    { sender: 'user', content: 'I need an electrician in Lekki' },
                    { sender: 'assistant', content: 'Found Tunde Electrician (4.9★, 300m away, verified). Shall I book him for you?' },
                    { sender: 'user', content: 'Yes please, book Tunde' },
                    { sender: 'assistant', content: 'Done! Tunde is on his way. ₦5,000 held securely in Moniepoint escrow until you confirm the repair is complete.' }
                ]
            });
        }
    });
</script>

