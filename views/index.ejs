            <span class="ticker-label">🟢 NEARBY RADAR:</span>
            <span id="ticker-radar-text" class="ticker-radar-text">Loading real-time micro-operations across Nigeria...</span>
        </div>
    </div>
    <script>
        (function() {
            async function loadRadarTicker() {
                try {
                    const res = await fetch('/api/stats/radar');
                    const data = await res.json();
                    if (data && data.success && data.radars) {
                        const radarTexts = data.radars.map(p => p.text).join('   •   ');
                        const el = document.getElementById('ticker-radar-text');
                        if (el) {
                            el.textContent = radarTexts;
                        }
                    }
                } catch(e) {
                    console.error('Failed loading radar ticker', e);
                }
            }
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', loadRadarTicker);
            } else {
                loadRadarTicker();
            }
        })();
    </script>

