<main>
    <!-- Top Announcement Banner -->
    <% 
        const defaultBannerTexts = [
            "One number. One conversation. Every Hustle.",
            "Tell it what you want — always ready to assist.",
            "The always-on neighborhood helper right in your chat.",
            "Find local riders, fixers, and electricians instantly.",
            "List your skills, offer services, and discover daily local jobs.",
            "Keep your transactions secure with smart escrow payments.",
            "Receive real-time, proactive notifications and opportunity alerts.",
            "Get daily reminders, price checks, and marketplace updates.",
            "Support your family and send secure mobile money home.",
            "No downloads. No new apps. All through one conversation.",
            "Multi-sided OS designed for everyday tasks & life"
        ];
        const bannerList = (typeof rotatingTexts !== 'undefined' && Array.isArray(rotatingTexts) && rotatingTexts.length > 0) 
            ? rotatingTexts 
            : defaultBannerTexts;
    %>
    <div class="announcement-banner">
        <span class="announcement-banner-text"><%= bannerList[0] %></span> 
    </div>

    <script id="rotating-banner-data" type="application/json"><%- JSON.stringify(bannerList) %></script>
    <script>
        (function() {
            function initBanner() {
                const bannerTextEl = document.querySelector('.announcement-banner-text');
                if (!bannerTextEl) return;

                let texts = [];
                try {
                    const dataEl = document.getElementById('rotating-banner-data');
                    if (dataEl && dataEl.textContent) {
                        texts = JSON.parse(dataEl.textContent);
                    }
                } catch (e) {}

                if (!Array.isArray(texts) || texts.length === 0) {
                    texts = [
                        "One number. One conversation. Every Hustle.",
                        "Tell it what you want — always ready to assist.",
                        "The always-on neighborhood helper right in your chat.",
                        "Find local riders, fixers, and electricians instantly.",
                        "List your skills, offer services, and discover daily local jobs.",
                        "Keep your transactions secure with smart escrow payments.",
                        "Receive real-time, proactive notifications and opportunity alerts.",
                        "Get daily reminders, price checks, and marketplace updates.",
                        "Support your family and send secure mobile money home.",
                        "No downloads. No new apps. All through one conversation.",
                        "Multi-sided OS designed for everyday tasks & life"
                    ];
                }

                let currentIndex = 0;
                setInterval(() => {
                    bannerTextEl.style.opacity = '0';
                    setTimeout(() => {
                        currentIndex = (currentIndex + 1) % texts.length;
                        bannerTextEl.textContent = texts[currentIndex];
                        bannerTextEl.style.opacity = '0.9';
                    }, 600);
                }, 4500);

                // Check for live updates asynchronously with safe fallback
                if (typeof window.fetch === 'function') {
                    fetch('/api/content/rotating-texts')
                        .then(res => {
                            if (!res.ok) return null;
                            return res.json();
                        })
                        .then(data => {
                            if (data && Array.isArray(data.texts) && data.texts.length > 0) {
                                texts = data.texts;
                            }
                        })
                        .catch(() => {
                            // Safe fallback to preloaded texts
                        });
                }
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initBanner);
            } else {
                initBanner();
            }
        })();
    </script>

