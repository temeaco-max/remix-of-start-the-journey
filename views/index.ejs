<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Kurukoo</title>
  <link rel="stylesheet" href="/css/kurukoo-home.css?v=2" />
  <link rel="stylesheet" href="/css/chat-ui.css?v=1" />
</head>
<body class="ko-home">
  <nav class="ko-nav" aria-label="Primary">
    <a class="ko-nav__brand" href="/">Kurukoo</a>
    <ul class="ko-nav__links">
      <li><a href="/#how">How it works</a></li>
      <li><a href="/#channels">Channels</a></li>
      <li><a href="/login">Login</a></li>
    </ul>
  </nav>
  <header class="ko-hero">
    <h1>Trade with trust across Africa</h1>
    <p>Escrow, circles, and multi-channel chat — built for real commerce.</p>
  </header>
  <section class="ko-mandate" aria-label="Mandates">
    <span class="ko-chip">Escrow</span>
    <span class="ko-chip">Safety circles</span>
    <span class="ko-chip">Multi-channel</span>
  </section>
  <section class="ko-grid" id="how">
    <article class="ko-card"><h3>Buy safely</h3><p>Funds held until delivery is confirmed.</p></article>
    <article class="ko-card"><h3>Sell with confidence</h3><p>Verified buyers and dispute support.</p></article>
    <article class="ko-card"><h3>Chat everywhere</h3><p>Web, WhatsApp, and more in one thread.</p></article>
  </section>
  <section class="ko-channels" id="channels">
    <h2>Channels</h2>
    <div class="ko-channel-list">
      <a href="/chat">Web chat</a>
      <a href="/login">Sign in</a>
    </div>
  </section>
  <footer class="ko-footer">© Kurukoo</footer>
  <script src="/js/kurukoo-primary-chat.js" defer></script>
</body>
</html>
