<script src="/js/kurukoo-chat.js"></script>
<script>
    window.addEventListener('DOMContentLoaded', () => {
        KurukooChat.init({
            containerId: 'homepage-live-chat-embed',
            mode: 'homepage_simulation',
            mockScript: [
                { sender: 'assistant', content: 'Ku Kurukoo! 🌅 Found 4 hot active deals and services near you in Ikeja right now. Swipe & click to book or purchase instantly!' },
                { sender: 'assistant', content: '[PRODUCTS_4X4]' },
                { sender: 'user', content: 'Order fresh oranges Nigeria' },
                { sender: 'assistant', content: 'Perfect! Mama Ngozi is heading your way with fresh oranges. Her live location is active — expect her in 5 minutes. 🍊' },
                { sender: 'user', content: 'I need a plumber' },
                { sender: 'assistant', content: 'Found 3 plumbers near you in Ikeja. Chidi (4.8★, verified) can come tomorrow 8am.' },
                { sender: 'user', content: 'Book Chidi' },
                { sender: 'assistant', content: 'Done! Chidi arrives tomorrow 8am. Estimated ₦5,000. I’ll remind you 1 hour before.' },
                { sender: 'assistant', content: 'You’ve earned 5 Points for completing your booking. You now have 35 Points. You can boost your own listing or keep them for discounts.' }
            ]
        });

        // Rotating Radar Feed logic
        function rotateRadarFeed() {
            const list = document.querySelector('.radar-list');
            if (!list) return;
            
            const firstItem = list.firstElementChild;
            if (!firstItem) return;
            
            const height = firstItem.offsetHeight;
            const parentStyle = window.getComputedStyle(list);
            const gap = parseFloat(parentStyle.rowGap || parentStyle.gap) || 14;
            const totalHeight = height + gap;
            
            // Apply smooth slide up and fade out
            firstItem.style.transition = 'all 0.8s cubic-bezier(0.4, 0, 0.2, 1)';
            firstItem.style.opacity = '0';
            firstItem.style.marginTop = `-${totalHeight}px`;
            firstItem.style.transform = 'scale(0.95)';
            
            setTimeout(() => {
                // Instantly remove styles and cycle the item to the end
                firstItem.style.transition = 'none';
                firstItem.style.opacity = '';
                firstItem.style.marginTop = '';
                firstItem.style.transform = '';
                list.appendChild(firstItem);
            }, 800);
        }
        
        // Rotate every 3.5 seconds
        setInterval(rotateRadarFeed, 3500);
    });
</script>

