<%- include('_partials/head') %>
<%- include('_partials/nav') %>

<main class="container provider-main k-screen-set k-screen-set--network">
    <div class="breadcrumb-bar"><a href="/" class="breadcrumb-link">Home</a> / <span>Provider</span></div>

    <header class="k-screen-header provider-header">
        <div class="provider-avatar"><%= provider.initials %></div>
        <div>
            <span class="eyebrow">Provider profile</span>
            <h1 class="provider-h1"><%= provider.name %></h1>
            <div class="provider-meta-row"><span>Listed service area: <%= provider.location %></span><span>Request details require confirmation</span></div>
        </div>
    </header>

    <div class="k-context-band" aria-label="Provider evidence boundary"><div class="k-context-mark" aria-hidden="true">K</div><div><strong>Network evidence boundary</strong><span>Listed capability is not the same as current availability, price, payment or fulfilment.</span></div><a href="/chat?prompt=<%= encodeURIComponent(`I want to request a service from ${provider.name}`) %>&providerSlug=<%= encodeURIComponent(provider.slug || provider.id || provider.phone || provider.name) %>">Continue in Chat</a></div>

    <section class="section-mb-40 k-screen-panel">
        <div class="section-heading section-heading--left"><span class="eyebrow">Capabilities</span><h2 class="section-h2">Services offered</h2><p class="page-desc">Capabilities shown here are profile data. Kurukoo checks the relevant provider and request state before protected actions.</p></div>
        <div class="skills-grid">
            <% provider.skills.forEach(function(skill) { %>
            <div class="skill-card k-screen-card"><div class="skill-name"><%= skill.skill %></div><div class="skill-meta"><span>Listed capability</span><% if (skill.hourlyRate > 0) { %><span>Rate subject to confirmation</span><% } %></div></div>
            <% }) %>
        </div>
    </section>

    <section class="banner-cta-card k-screen-panel"><span class="eyebrow">Canonical request path</span><h2 class="banner-cta-h2">Connect with <%= provider.name %></h2><p class="banner-cta-p">Start a request in Web Chat. Kurukoo preserves the provider reference and presents the next supported action only after the required checks.</p><a href="/chat?prompt=<%= encodeURIComponent(`I want to request a service from ${provider.name}`) %>&providerSlug=<%= encodeURIComponent(provider.slug || provider.id || provider.phone || provider.name) %>" class="btn btn-primary">Start in Web Chat</a></section>

    <section class="section-mb-40 k-screen-panel"><div class="section-heading section-heading--left"><span class="eyebrow">Trust &amp; safety</span><h2 class="section-h2">Evidence before fulfilment</h2></div><div class="k-evidence-grid"><div class="k-evidence-item"><span>Profile</span><strong>Listed capability</strong></div><div class="k-evidence-item"><span>Availability</span><strong>Requires confirmation</strong></div><div class="k-evidence-item"><span>Payment</span><strong>Integration-dependent</strong></div><div class="k-evidence-item"><span>Fulfilment</span><strong>Request-dependent</strong></div></div><div class="trust-safety-card"><ul class="trust-list"><li class="trust-item"><span class="check-green">&#10003;</span> Provider details are reviewed in the request flow before a protected action is presented.</li><li class="trust-item"><span class="check-green">&#10003;</span> Payment and escrow steps apply only when their verified integrations are available.</li><li class="trust-item"><span class="check-green">&#10003;</span> The canonical request lifecycle records applicable evidence and dispute steps when those actions are used.</li></ul></div></section>

    <% if (faqs && faqs.length > 0) { %><section class="section-mb-40"><h2 class="section-h2">Frequently asked questions</h2><div><% faqs.forEach(function(f) { %><details class="faq-item-details"><summary class="faq-item-summary"><%= f.question %></summary><p class="faq-item-answer"><%= f.answer %></p></details><% }) %></div></section><% } %>

    <p class="privacy-notice-text">&#128274; This public profile does not display a phone number. Any follow-up begins in Web Chat and presents only the next supported action.</p>
</main>

<%- include('_partials/footer') %>