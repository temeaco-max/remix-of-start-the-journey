<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Completing Kurukoo sign-in</title>
  <link rel="icon" href="/assets/brand/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/site.css?v=1.2.0">
  <link rel="stylesheet" href="/css/kurukoo-auth.css?v=5">
</head>
<body class="kurukoo-auth-page">
<main class="conversation-auth-shell" style="grid-template-columns:1fr">
  <section class="conversation-auth-card" style="margin:48px auto;max-width:480px">
    <img src="/assets/brand/logo-icon.svg" alt="Kurukoo" class="auth-card-logo" width="48" height="48">
    <span class="auth-kicker">Progressive identity</span>
    <h2 id="auth-title">Completing sign-in…</h2>
    <p id="auth-subtitle">One-time link. Single use. Phone remains the primary channel identity once proven.</p>
    <div id="auth-feedback" class="auth-feedback" hidden></div>
    <a class="auth-return" href="/chat">Back to chat</a>
  </section>
</main>
<script>
(() => {
  const token = <%- JSON.stringify(typeof challengeToken !== 'undefined' ? challengeToken : '') %>;
  const returnTo = <%- JSON.stringify(typeof returnTo !== 'undefined' && returnTo ? returnTo : '/chat') %>;
  const feedback = document.getElementById('auth-feedback');
  const title = document.getElementById('auth-title');
  const show = (message, isError) => { feedback.hidden = false; feedback.textContent = message; feedback.classList.toggle('error', Boolean(isError)); };
  if (!token) { title.textContent = 'Link missing'; show('Request a new magic link from continue with Kurukoo.', true); return; }
  fetch('/api/auth/complete-challenge', {
    method: 'POST', credentials: 'same-origin',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ token }),
  }).then(async (response) => {
    const data = await response.json().catch(() => ({}));
    if (!response.ok || !data.success) throw new Error(data.message || 'Sign-in link could not be completed');
    if (data.token) localStorage.setItem('kurukoo_auth_token', data.token);
    if (data.phone) localStorage.setItem('kurukoo_user_phone', data.phone);
    title.textContent = data.provisional ? 'Email credential connected' : 'You are signed in';
    show(data.message || 'Continuing…');
    const target = (data.returnPath && String(data.returnPath).startsWith('/')) ? data.returnPath : (returnTo.startsWith('/') ? returnTo : '/chat');
    window.setTimeout(() => { window.location.assign(target); }, 700);
  }).catch((error) => {
    title.textContent = 'Sign-in could not complete';
    show(error.message || 'Request a new magic link.', true);
  });
})();
</script>
</body>
</html>
