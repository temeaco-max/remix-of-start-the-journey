<%- include('_partials/head') %>
<%- include('_partials/nav') %>
<main class="linked-device-page">
  <section class="linked-device-shell" aria-labelledby="linked-device-title">
    <div class="linked-device-copy">
      <p class="eyebrow">Personal channel</p>
      <h1 id="linked-device-title">Link WhatsApp to Kurukoo</h1>
      <p class="linked-device-lede">Scan this code with the owner’s iPhone, just as you would when linking WhatsApp Web. Your messages will continue through the same Kurukoo conversation and action system.</p>
      <div class="linked-device-steps" aria-label="Pairing steps">
        <div><span>1</span><p>Open WhatsApp on the owner phone.</p></div>
        <div><span>2</span><p>Open <strong>Linked devices</strong> and choose <strong>Link a device</strong>.</p></div>
        <div><span>3</span><p>Scan the code and keep the local connector running.</p></div>
      </div>
      <p class="linked-device-note"><strong>Private account:</strong> this is a local linked-device session, not a Meta Cloud API business number. Group messages stay off unless explicitly enabled.</p>
    </div>
    <%- include('_partials/whatsapp-linked-device-panel') %>
  </section>
</main>
<%- include('_partials/footer') %>
