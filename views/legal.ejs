<%- include('_partials/head') %>
<%- include('_partials/nav') %>

<main class="k-screen-set k-screen-set--content">
    <section class="viewslegalejs-st-1 section"><div class="container k-screen-header"><span class="eyebrow">Trust &amp; transparency</span><h1 class="viewslegalejs-st-2">Legal &amp; Privacy</h1><p class="viewslegalejs-st-3">Last Updated: July 2026</p></div></section>

    <section class="section container">
        <div class="k-legal-layout">
            <aside class="k-legal-nav" aria-label="Legal sections"><a href="/legal/privacy" aria-current="<%= section === 'privacy' ? 'true' : 'false' %>">Privacy Policy</a><a href="/legal/terms" aria-current="<%= section === 'terms' ? 'true' : 'false' %>">Terms of Service</a><a href="/legal/cookies" aria-current="<%= section === 'cookies' ? 'true' : 'false' %>">Cookie Policy</a><a href="/help">Help &amp; support</a><a href="/chat?prompt=I%20have%20a%20privacy%20question">Ask Kurukoo</a></aside>

            <article class="k-legal-content viewslegalejs-st-7">
                <% if (section === 'privacy') { %>
                    <h2>Privacy Policy</h2>
                    <p>At Kurukoo, we take your privacy seriously. This policy explains how we collect, use, and protect your personal information.</p>
                    <h3>1. Data Collection</h3><p>We collect minimal data necessary to provide our services, including your phone number, location (when requested), and service preferences.</p>
                    <h3>2. How We Use Your Data</h3><p>Your data is used to match you with service providers, process payments, and improve our AI's understanding of your needs.</p>
                    <h3>3. Data Security</h3><p>All personal phone numbers are masked via a privacy bridge. We use AES-256 encryption at rest and TLS 1.3 in transit.</p>
                <% } else if (section === 'terms') { %>
                    <h2>Terms of Service</h2><p>By using Kurukoo, you agree to these terms. Please read them carefully.</p>
                    <h3>1. Service Description</h3><p>Kurukoo is a utility platform connecting users with service providers. We act as an intermediary for most services.</p>
                    <h3>2. User Responsibilities</h3><p>Users are responsible for providing accurate information and respecting the providers they connect with.</p>
                    <h3>3. Points &amp; Payments</h3><p>Points and payment behavior depend on the active deployment and verified payment boundary. The interface must not imply settlement where no payment provider has confirmed it.</p>
                <% } else { %>
                    <h2>Cookie Policy</h2><p>We use cookies to enhance your experience on our platform.</p><p>These are essential for maintaining your session and remembering your preferences across the app and website.</p>
                <% } %>
            </article>
        </div>
    </section>
</main>

<%- include('_partials/footer') %>
