<%- include('_partials/head', { pageStyles: ['/css/kurukoo-public-pages.css?v=4','/css/kurukoo-channel-page.css?v=2'] }) %>
<%- include('_partials/nav') %>
<% const statuses = typeof channelStatuses === 'object' && channelStatuses ? channelStatuses : {}; const aiState = process.env.KURUKOO_MCP_ENABLED === 'true' ? 'READY' : 'NOT_CONFIGURED'; const aiNote = process.env.KURUKOO_MCP_ENABLED === 'true' ? 'One remote MCP connection surface for compatible AI assistants. Availability of write actions depends on the external assistant.' : 'Enable KURUKOO_MCP_ENABLED and configure the public HTTPS issuer/client relationship before allowing external AI control.'; const label = (key, fallback) => String(statuses[key]?.state || fallback || 'NOT_CONFIGURED').replaceAll('_', ' '); %>
<main class="container page-container frontend-channel-page" aria-labelledby="channels-title">
  <section class="page-header-center frontend-channel-page__header"><span class="badge-pill">Channels & connections</span><h1 id="channels-title" class="page-title">One Kurukoo relationship, different access points.</h1><p class="page-desc">Use Kurukoo through its conversation channels or connect the sources you already use. Every surface preserves the same identity, context and truthful readiness state.</p></section>

  <section class="channel-group" aria-labelledby="kurukoo-channels-title">
    <h2 id="kurukoo-channels-title" class="channel-group-title">Kurukoo communication channels</h2>
    <p class="channel-note">These are the channels through which you communicate with Kurukoo. Provider delivery remains inactive until the documented credentials, callback evidence and runtime checks are present.</p>
    <div class="channel-cards">
      <article class="channel-card available"><div class="channel-icon">W</div><span class="channel-state active">READY</span><h3>Web Chat</h3><p>Start a conversation, review request details, manage reminders and continue protected actions when identity is required.</p><a href="/chat" class="btn btn-primary btn-sm">Start chatting</a></article>
      <article id="ai-assistants" class="channel-card <%= aiState === 'READY' ? 'available' : 'unavailable' %>"><div class="channel-icon">AI</div><span class="channel-state <%= aiState === 'READY' ? 'active' : '' %>"><%= aiState.replaceAll('_', ' ') %></span><h3>AI assistants</h3><p><%= aiNote %></p><div class="channel-setup"><strong>One Kurukoo MCP endpoint</strong> Compatible clients may include ChatGPT, Claude, Gemini, Grok, Copilot, Dola and other assistants that support remote MCP/custom apps. Kurukoo does not receive another AI provider’s password, session or subscription credential.</div><a href="/connect#ai-assistants" class="btn btn-primary btn-sm">View connection settings</a></article>
      <article id="whatsapp" class="channel-card unavailable"><div class="channel-icon">WA</div><span class="channel-state"><%= label('whatsapp') %></span><h3>WhatsApp</h3><p><%= statuses.whatsapp?.note || 'The official WhatsApp adapter uses canonical Chat identity and webhook boundaries.' %></p><div class="channel-setup"><strong>Activation boundary</strong> Set provider token, phone-number ID, webhook verification values and callback evidence before delivery is claimed.</div></article>
      <article id="telegram" class="channel-card unavailable"><div class="channel-icon">TG</div><span class="channel-state"><%= label('telegram') %></span><h3>Telegram</h3><p><%= statuses.telegram?.note || 'Telegram uses the shared channel and conversation authority.' %></p><div class="channel-setup"><strong>Activation boundary</strong> Set the bot token and webhook secret, register the callback and verify delivery.</div></article>
      <article id="sms" class="channel-card unavailable"><div class="channel-icon">SMS</div><span class="channel-state"><%= label('sms') %></span><h3>SMS</h3><p><%= statuses.sms?.note || 'SMS uses normalized phone identity and the canonical request lifecycle.' %></p><div class="channel-setup"><strong>Activation boundary</strong> Configure the carrier adapter and verify inbound and outbound delivery.</div></article>
      <article id="ussd" class="channel-card unavailable"><div class="channel-icon">US</div><span class="channel-state"><%= label('ussd') %></span><h3>USSD</h3><p><%= statuses.ussd?.note || 'USSD menus map feature-phone input into the same identity and request semantics.' %></p><div class="channel-setup"><strong>Activation boundary</strong> Configure carrier routing and callback credentials. Session and pagination remain provider-independent.</div></article>
      <article id="email" class="channel-card unavailable"><div class="channel-icon">EM</div><span class="channel-state"><%= label('email') %></span><h3>Email</h3><p><%= statuses.email?.note || 'Email inbound and outbound paths preserve the canonical conversation boundary.' %></p><div class="channel-setup"><strong>Activation boundary</strong> Configure the mail provider and signed delivery callbacks before claiming delivery.</div></article>
      <article id="fcm" class="channel-card unavailable"><div class="channel-icon">FC</div><span class="channel-state"><%= label('fcm') %></span><h3>Push notifications</h3><p><%= statuses.fcm?.note || 'Internal notifications remain available when external push is not configured.' %></p><div class="channel-setup"><strong>Activation boundary</strong> Provide FCM credentials and verify provider delivery. Internal inbox persistence is not external delivery.</div></article>
      <article id="voice" class="channel-card unavailable"><div class="channel-icon">VO</div><span class="channel-state"><%= label('voice') %></span><h3>Web Voice</h3><p><%= statuses.voice?.note || 'Voice remains the same Kurukoo relationship with bounded realtime tools.' %></p><div class="channel-setup"><strong>Activation boundary</strong> Enable the configured realtime provider and verify quota and audio delivery.</div></article>
    </div>
  </section>

  <section class="channel-group frontend-channel-page__sources" aria-labelledby="source-connections-title">
    <h2 id="source-connections-title" class="channel-group-title">Connected sources</h2>
    <p class="channel-note">These connections let Kurukoo work with information you already keep elsewhere. They are not communication channels and do not make an external source a Kurukoo provider.</p>
    <div class="frontend-channel-page__cards" aria-label="Source connections">
      <article class="frontend-channel-card"><div class="frontend-channel-card__icon frontend-channel-card__icon--drive"><svg class="k-icon" aria-hidden="true"><use href="/icons/kurukoo-icons.svg#document"></use></svg></div><h3>Google Drive</h3><p>Access your Docs, Sheets, Slides and more.</p><span class="frontend-channel-card__state">Not connected</span><a class="btn btn-outline" href="/login?return=%2Fconnect">Connect</a></article>
      <article class="frontend-channel-card"><div class="frontend-channel-card__icon frontend-channel-card__icon--sheets"><svg class="k-icon" aria-hidden="true"><use href="/icons/kurukoo-icons.svg#list"></use></svg></div><h3>Google Sheets</h3><p>Bring your spreadsheets into the conversation.</p><span class="frontend-channel-card__state">Not connected</span><a class="btn btn-outline" href="/login?return=%2Fconnect">Connect</a></article>
      <article class="frontend-channel-card"><div class="frontend-channel-card__icon frontend-channel-card__icon--notion"><svg class="k-icon" aria-hidden="true"><use href="/icons/kurukoo-icons.svg#note"></use></svg></div><h3>Notion</h3><p>Notes, docs and databases that stay in sync.</p><span class="frontend-channel-card__state">Not connected</span><a class="btn btn-outline" href="/login?return=%2Fconnect">Connect</a></article>
      <article class="frontend-channel-card"><div class="frontend-channel-card__icon frontend-channel-card__icon--outlook"><svg class="k-icon" aria-hidden="true"><use href="/icons/kurukoo-icons.svg#mail"></use></svg></div><h3>Microsoft Outlook</h3><p>Find emails and attachments when you need them.</p><span class="frontend-channel-card__state">Not connected</span><a class="btn btn-outline" href="/login?return=%2Fconnect">Connect</a></article>
      <article class="frontend-channel-card"><div class="frontend-channel-card__icon frontend-channel-card__icon--onedrive"><svg class="k-icon" aria-hidden="true"><use href="/icons/kurukoo-icons.svg#folder"></use></svg></div><h3>Microsoft OneDrive</h3><p>Access your files in OneDrive.</p><span class="frontend-channel-card__state">Not connected</span><a class="btn btn-outline" href="/login?return=%2Fconnect">Connect</a></article>
    </div>
    <aside class="frontend-channel-readiness"><svg class="k-icon" aria-hidden="true"><use href="/icons/kurukoo-icons.svg#info"></use></svg><div><strong>Connection readiness</strong><p>Some sources require admin approval or additional setup before Kurukoo can connect. We’ll guide you through each step.</p></div><a class="btn btn-outline" href="/help">Learn more</a></aside>
  </section>
</main>
<%- include('_partials/footer') %>
